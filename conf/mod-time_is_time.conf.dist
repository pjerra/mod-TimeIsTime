#####################################################################################################
[worldserver]

# Announce
#####################################################################################################
# Announce  TimeIsTime
# Settings: 0 = off, 1 = on
# Default:  1 
# Example:  TimeIsTime.Announce = 1 
#####################################################################################################
TimeIsTime.Announce = 1

# Enable
#####################################################################################################
# Enable TimeIsTime
# Settings: 0 = off, 1 = on
# Default:  1
# Example:  TimeIsTime.Enable = 1 
#####################################################################################################
TimeIsTime.Enable = 1

# SpeedRate
#####################################################################################################
# Adjust the number of game days per real day by altering the Realm Timer
# Settings: 60 is 1 second (Real Time) = 1 minute (Realm Timer)
#           
#           60.0  = 1 Game Day every 24   minutes
#           30.0  = 1 Game Day every 48   minutes         
#           15.0  = 1 Game Day every 96   minutes or 1.6  Hours
#           7.5   = 1 Game Day every 192  minutes or 3.2  Hours
#           3.75  = 1 Game Day every 384  minutes or 6.4  Hours        
#           1.875 = 1 Game Day every 768  minutes or 12.8 Hours
#           1.0   = 1 Game Day every 1440 minutes or 24.0 Hours 
# Default:  1.0 (Blizzlike)
# Example:  TimeIsTime.SpeedRate = 1.0
#####################################################################################################
TimeIsTime.SpeedRate = 1.0

# TimeStart and HourOffset:
#####################################################################################################
# Start (client side) game clock at chosen Epoch (Unix) time at the same time each login
# Default:  0  (Local Time)
# Example:  Based on the settings below, the GMT TimeStart and HourOffset would be:
#           TimeIsTime.TimeStart = 205364700
#           TimeIsTime.HourOffset = 5
#           City: Chicago, IL USA
#           Summer Solstice Date   :: 06-20-2008
#           Sunrise  = 05:15:27    :: 1213938927
#           Sunset   = 20:29:01    :: 1213993741
#           Midday   = 12:00:00    :: 1213963200
#           Midnight = 24:00:00    :: 1213920000
#####################################################################################################
TimeIsTime.TimeStart = 0
TimeIsTime.HourOffset = 0.0

# RealignDate
#####################################################################################################
# Keep the in-game calendar date locked to the server's real date.
#
# With SpeedRate above 1.0 the client clock crosses midnight more often than the server does,
# and each of those crossings advances the calendar day. Enabling this makes the module re-query
# the server date every time the accelerated clock rolls over midnight and stamp that date onto
# the client, so only a real midnight moves the calendar forward. The accelerated time of day is
# untouched -- sunrise and sunset still cycle at SpeedRate.
#
# Example:  TimeIsTime.SpeedRate = 2.0 reaches midnight at server noon. That first turnover is
#           re-stamped with the current (unchanged) server date, so the calendar holds. The second
#           turnover lands at real midnight, where the server date has genuinely advanced, and the
#           calendar moves with it.
#
# Note:     This also applies when TimeStart is set, so the client will show the server's real
#           date rather than the date encoded in the TimeStart epoch. The time of day chosen by
#           TimeStart and HourOffset is preserved.
#
# Settings: 0 = off, 1 = on
# Default:  1
# Example:  TimeIsTime.RealignDate = 0
#####################################################################################################
TimeIsTime.RealignDate = 1

# RealignDateLookahead
#####################################################################################################
# Minutes added to the server clock when sampling which date to stamp on a turnover.
#
# Only used when TimeIsTime.RealignDate = 1. Without it, an accelerated midnight that lands a few
# seconds before real midnight would be stamped with the day that is about to end, stalling the
# calendar for a full extra cycle. Sampling slightly ahead makes that near-miss resolve to the day
# the server is about to enter.
#
# Settings: Minutes, accepts fractional values. 0 disables the allowance.
# Default:  1.0
# Example:  TimeIsTime.RealignDateLookahead = 1.0
#####################################################################################################
TimeIsTime.RealignDateLookahead = 1.0
